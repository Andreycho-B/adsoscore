---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Iniciar sesion">
  <div style="display:grid;grid-template-columns:minmax(320px, 4.6fr) minmax(380px, 5.4fr);min-height:100vh;">
    <div style="background:var(--color-primary);color:#fff;padding:clamp(32px, 5vw, 64px);display:flex;flex-direction:column;justify-content:space-between;gap:32px;position:relative;overflow:hidden;">
      <svg width="220" height="220" viewBox="0 0 220 220" fill="none" aria-hidden="true" style="position:absolute;top:-40px;right:-40px;opacity:0.18;color:#fff;">
        <defs><pattern id="fdot" width="22" height="22" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1.6" fill="currentColor"/></pattern></defs>
        <rect width="220" height="220" fill="url(#fdot)"/>
      </svg>
      <div style="position:absolute;bottom:-140px;left:-100px;width:320px;height:320px;border-radius:50%;background:var(--color-primary-dark);opacity:0.45;"></div>
      <div style="position:relative;display:flex;align-items:center;gap:12px;">
        <span style="display:inline-flex;width:30px;height:30px;border-radius:8px;background:rgba(255,255,255,0.16);align-items:center;justify-content:center;">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1.5 7l3.5 3.5L12.5 3" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <span style="font-weight:600;font-size:18px;letter-spacing:-0.01em;color:#fff;white-space:nowrap;">ADSOscore</span>
      </div>
      <div style="position:relative;max-width:42ch;">
        <h1 style="color:#fff;font-size:clamp(36px, 5.6vw, 64px);letter-spacing:-0.025em;line-height:1.08;margin-bottom:20px;">Evalua empresas ADSO con datos reales</h1>
        <p style="color:rgba(255,255,255,0.82);font-size:18px;line-height:1.55;margin-bottom:24px;">Scores inteligentes basados en GitHub, RUES, ubicacion y mas. Toma la mejor decision para tu aprendizaje.</p>
        <ul style="list-style:none;margin:0;padding:0;">
          <li style="display:flex;gap:12px;align-items:flex-start;padding:8px 0;color:rgba(255,255,255,0.92);font-size:18px;line-height:1.45;">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" style="flex:0 0 auto;margin-top:4px;"><path d="M3.5 9.5L7 13l7.5-8" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>136+ ofertas evaluadas</span>
          </li>
          <li style="display:flex;gap:12px;align-items:flex-start;padding:8px 0;color:rgba(255,255,255,0.92);font-size:18px;line-height:1.45;">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" style="flex:0 0 auto;margin-top:4px;"><path d="M3.5 9.5L7 13l7.5-8" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>10 parametros de evaluacion</span>
          </li>
          <li style="display:flex;gap:12px;align-items:flex-start;padding:8px 0;color:rgba(255,255,255,0.92);font-size:18px;line-height:1.45;">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" style="flex:0 0 auto;margin-top:4px;"><path d="M3.5 9.5L7 13l7.5-8" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>Resenas de aprendices reales</span>
          </li>
        </ul>
      </div>
      <div style="position:relative;display:flex;align-items:center;gap:12px;color:rgba(255,255,255,0.7);font-size:12px;">
        <span style="display:inline-flex;width:8px;height:8px;border-radius:50%;background:var(--color-success);box-shadow:0 0 0 4px rgba(255,255,255,0.12);"></span>
        <span>Sistema de evaluacion activo</span>
      </div>
    </div>

    <div style="display:flex;align-items:center;justify-content:center;padding:clamp(24px, 4vw, 64px);background:var(--color-bg-layout);">
      <div style="width:100%;max-width:520px;background:var(--color-bg-container);border:1px solid var(--color-border-secondary);border-radius:10px;padding:clamp(28px, 4vw, 44px);box-shadow:0 24px 60px var(--color-fill-quaternary), 0 2px 8px var(--color-fill-quaternary);">
        <header style="margin-bottom:24px;">
          <h2 style="font-size:clamp(26px, 3.2vw, 38px);letter-spacing:-0.015em;margin-bottom:8px;">Iniciar sesion</h2>
          <p style="color:var(--color-text-tertiary);font-size:14px;">Elige tu proveedor de identidad para continuar.</p>
        </header>

        <div style="display:flex;flex-direction:column;gap:12px;">
          <a
            href="/api/auth/signin/google"
            style="display:flex;align-items:center;justify-content:center;gap:12px;width:100%;height:40px;padding:0 24px;font-size:14px;font-weight:600;color:var(--color-text);background:var(--color-bg-container);border:1px solid var(--color-border);border-radius:8px;text-decoration:none;transition:all 0.2s cubic-bezier(0.645, 0.045, 0.355, 1);"
          >
            <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
              <path fill="#4285F4" d="M23.745 12.27c0-.79-.07-1.54-.19-2.27h-11.3v4.51h6.47c-.29 1.48-1.14 2.73-2.4 3.58v3h3.86c2.26-2.09 3.56-5.17 3.56-8.82z"/>
              <path fill="#34A853" d="M12.255 24c3.24 0 5.95-1.08 7.93-2.91l-3.86-3c-1.08.72-2.45 1.16-4.07 1.16-3.13 0-5.78-2.11-6.73-4.96h-3.98v3.09C3.515 21.3 7.565 24 12.255 24z"/>
              <path fill="#FBBC05" d="M5.525 14.29c-.25-.72-.38-1.49-.38-2.29s.14-1.57.38-2.29V6.62h-3.98a11.86 11.86 0 000 10.76l3.98-3.09z"/>
              <path fill="#EA4335" d="M12.255 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C18.205 1.19 15.495 0 12.255 0c-4.69 0-8.74 2.7-10.71 6.62l3.98 3.09c.95-2.85 3.6-4.96 6.73-4.96z"/>
            </svg>
            Continuar con Google
          </a>

          <a
            href="/api/auth/signin/github"
            style="display:flex;align-items:center;justify-content:center;gap:12px;width:100%;height:40px;padding:0 24px;font-size:14px;font-weight:600;color:var(--color-text);background:var(--color-bg-container);border:1px solid var(--color-border);border-radius:8px;text-decoration:none;transition:all 0.2s cubic-bezier(0.645, 0.045, 0.355, 1);"
          >
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            Continuar con GitHub
          </a>
        </div>

        <div style="margin:24px 0;padding-top:24px;border-top:1px solid var(--color-border-secondary);display:flex;align-items:center;justify-content:center;gap:8px;font-size:12px;color:var(--color-text-quaternary);">
          <svg width="13" height="14" viewBox="0 0 13 14" fill="none" aria-hidden="true" style="flex:0 0 auto;"><path d="M2 6V4.5a4.5 4.5 0 019 0V6m-10 0h11v7H1.5z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>Solo para aprendices del SENA. Tus datos estan protegidos.</span>
        </div>

        <div style="margin-top:24px;padding-top:24px;border-top:1px solid var(--color-border-secondary);display:flex;align-items:center;justify-content:center;">
          <a href="/" style="font-size:12px;color:var(--color-text-tertiary);text-decoration:none;">Volver al inicio</a>
        </div>
      </div>
    </div>
  </div>

  <style>
    @media (max-width: 900px) {
      div[style*="grid-template-columns:minmax(320px"] {
        grid-template-columns: 1fr !important;
      }
      div[style*="min-height: 340px"] {
        min-height: 340px !important;
      }
    }
  </style>
</BaseLayout>
