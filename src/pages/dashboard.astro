---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Dashboard">
  <div class="min-h-screen bg-surface">
    <!-- Header -->
    <header class="bg-white border-b border-border sticky top-0 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          <div class="flex items-center gap-2">
            <a href="/" class="text-xl font-bold text-primary">ADSOscore</a>
          </div>
          
          <nav class="hidden md:flex items-center gap-6">
            <a href="/dashboard" class="text-sm font-medium text-primary">
              Ofertas
            </a>
            <a href="/favorites" class="text-sm font-medium text-text-secondary hover:text-text">
              Favoritos
            </a>
            <a href="/notifications" class="text-sm font-medium text-text-secondary hover:text-text">
              Notificaciones
            </a>
          </nav>

          <div class="flex items-center gap-4">
            <button class="text-sm font-medium text-text-secondary hover:text-text">
              Mi perfil
            </button>
          </div>
        </div>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <!-- Filtros -->
      <div class="bg-white rounded-lg border border-border p-4 mb-6">
        <h2 class="text-sm font-semibold text-text mb-4">Filtros</h2>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
          <!-- Departamento -->
          <div>
            <label class="block text-xs font-medium text-text-secondary mb-1">
              Departamento
            </label>
            <select class="w-full px-3 py-2 text-sm border border-border rounded-lg bg-white text-text focus:outline-none focus:ring-2 focus:ring-primary">
              <option value="">Todos</option>
              <option value="Caldas">Caldas</option>
              <option value="Risaralda">Risaralda</option>
              <option value="Antioquia">Antioquia</option>
              <option value="Cundinamarca">Cundinamarca</option>
              <option value="Santander">Santander</option>
            </select>
          </div>

          <!-- Ciudad -->
          <div>
            <label class="block text-xs font-medium text-text-secondary mb-1">
              Ciudad
            </label>
            <select class="w-full px-3 py-2 text-sm border border-border rounded-lg bg-white text-text focus:outline-none focus:ring-2 focus:ring-primary">
              <option value="">Todas</option>
              <option value="Manizales">Manizales</option>
              <option value="Pereira">Pereira</option>
              <option value="Medellin">Medellin</option>
              <option value="Bogota">Bogota</option>
              <option value="Bucaramanga">Bucaramanga</option>
            </select>
          </div>

          <!-- Modalidad -->
          <div>
            <label class="block text-xs font-medium text-text-secondary mb-1">
              Modalidad
            </label>
            <select class="w-full px-3 py-2 text-sm border border-border rounded-lg bg-white text-text focus:outline-none focus:ring-2 focus:ring-primary">
              <option value="">Todas</option>
              <option value="Remoto">Remoto</option>
              <option value="Presencial">Presencial</option>
              <option value="Hibrido">Hibrido</option>
            </select>
          </div>

          <!-- Tag -->
          <div>
            <label class="block text-xs font-medium text-text-secondary mb-1">
              Tipo de empresa
            </label>
            <select class="w-full px-3 py-2 text-sm border border-border rounded-lg bg-white text-text focus:outline-none focus:ring-2 focus:ring-primary">
              <option value="">Todas</option>
              <option value="startup">Startup</option>
              <option value="consultora">Consultora</option>
              <option value="enterprise">Enterprise</option>
              <option value="fintech">Fintech</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Lista de ofertas -->
      <div class="space-y-4">
        <!-- Card de ejemplo -->
        <div class="bg-white rounded-lg border border-border p-6 hover:shadow-md transition-shadow">
          <div class="flex items-start justify-between">
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-2">
                <h3 class="text-lg font-semibold text-text">
                  Desarrollador Full Stack
                </h3>
                <span class="px-2 py-0.5 text-xs font-medium bg-success-light text-success rounded">
                  Remoto
                </span>
              </div>
              
              <p class="text-sm text-text-secondary mb-3">
                Tech Solutions S.A.S
              </p>

              <div class="flex items-center gap-4 text-xs text-text-muted">
                <span>Bogota, Cundinamarca</span>
                <span>Publicada hace 2 dias</span>
              </div>
            </div>

            <!-- Score -->
            <div class="flex flex-col items-end">
              <div class="flex items-center gap-2">
                <span class="text-2xl font-bold text-success">85</span>
                <span class="text-xs text-text-muted">/100</span>
              </div>
              <span class="text-xs font-medium text-success">Excelente</span>
            </div>
          </div>

          <!-- Actions -->
          <div class="flex items-center justify-between mt-4 pt-4 border-t border-border">
            <button class="text-sm font-medium text-text-secondary hover:text-text">
              Ver detalles
            </button>
            <button class="text-sm font-medium text-text-secondary hover:text-error">
              Guardar
            </button>
          </div>
        </div>

        <!-- Card de ejemplo 2 -->
        <div class="bg-white rounded-lg border border-border p-6 hover:shadow-md transition-shadow">
          <div class="flex items-start justify-between">
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-2">
                <h3 class="text-lg font-semibold text-text">
                  Practicante de Desarrollo
                </h3>
                <span class="px-2 py-0.5 text-xs font-medium bg-warning-light text-warning rounded">
                  Presencial
                </span>
              </div>
              
              <p class="text-sm text-text-secondary mb-3">
                Consultora XYZ Ltda
              </p>

              <div class="flex items-center gap-4 text-xs text-text-muted">
                <span>Manizales, Caldas</span>
                <span>Publicada hace 5 dias</span>
              </div>
            </div>

            <!-- Score -->
            <div class="flex flex-col items-end">
              <div class="flex items-center gap-2">
                <span class="text-2xl font-bold text-warning">62</span>
                <span class="text-xs text-text-muted">/100</span>
              </div>
              <span class="text-xs font-medium text-warning">Buena</span>
            </div>
          </div>

          <!-- Actions -->
          <div class="flex items-center justify-between mt-4 pt-4 border-t border-border">
            <button class="text-sm font-medium text-text-secondary hover:text-text">
              Ver detalles
            </button>
            <button class="text-sm font-medium text-text-secondary hover:text-error">
              Guardar
            </button>
          </div>
        </div>
      </div>
    </main>
  </div>
</BaseLayout>
