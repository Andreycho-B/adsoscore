---
import BaseLayout from '../layouts/BaseLayout.astro';
import { prisma } from '../lib/prisma';
import { getSession } from '../lib/auth';
import { getScoreLabel, getScoreColor } from '../lib/scoring';

const session = await getSession(Astro);
if (!session.user) {
  return Astro.redirect('/login');
}

const user = await prisma.user.findUnique({
  where: { id: session.user.id },
  select: { especialidadId: true },
});
const hasSynced = !!user?.especialidadId;

const url = new URL(Astro.request.url);
const departamento = url.searchParams.get('departamento') || '';
const ciudad = url.searchParams.get('ciudad') || '';
const modalidad = url.searchParams.get('modalidad') || '';

const where: any = {
  isActive: true,
  isVisible: true,
};

if (departamento) {
  where.departamento = { contains: departamento, mode: 'insensitive' };
}
if (ciudad) {
  where.ciudad = { contains: ciudad, mode: 'insensitive' };
}
if (modalidad) {
  where.modalidad = { equals: modalidad, mode: 'insensitive' };
}

let offers: any[] = [];
let departamentos: string[] = [];
let ciudades: string[] = [];

if (hasSynced) {
  const deptResult = await prisma.offer.findMany({
    where: { isActive: true, isVisible: true },
    select: { departamento: true },
    distinct: ['departamento'],
    orderBy: { departamento: 'asc' },
  });
  departamentos = deptResult.map((r) => r.departamento).filter(Boolean) as string[];

  const cityResult = await prisma.offer.findMany({
    where: { isActive: true, isVisible: true },
    select: { ciudad: true },
    distinct: ['ciudad'],
    orderBy: { ciudad: 'asc' },
  });
  ciudades = cityResult.map((r) => r.ciudad).filter(Boolean) as string[];

  offers = await prisma.offer.findMany({
    where,
    orderBy: { score: 'desc' },
    take: 50,
  });
}

function buildFilterUrl(params: Record<string, string>) {
  const searchParams = new URLSearchParams();
  if (params.departamento) searchParams.set('departamento', params.departamento);
  if (params.ciudad) searchParams.set('ciudad', params.ciudad);
  if (params.modalidad) searchParams.set('modalidad', params.modalidad);
  const qs = searchParams.toString();
  return `/dashboard${qs ? '?' + qs : ''}`;
}
---

<BaseLayout title="Dashboard">
  <div style="min-height:100vh;background:var(--color-bg-layout);">
    <header style="background:var(--color-bg-container);border-bottom:1px solid var(--color-border);position:sticky;top:0;z-index:40;">
      <div class="wrap" style="display:flex;justify-content:space-between;align-items:center;height:64px;">
        <div style="display:flex;align-items:center;gap:12px;">
          <a href="/" style="font-weight:600;font-size:18px;letter-spacing:-0.01em;color:var(--color-primary);text-decoration:none;">ADSOscore</a>
        </div>
        <nav aria-label="Navegacion principal" style="display:flex;gap:28px;align-items:center;">
          <a href="/dashboard" style="font-size:14px;font-weight:600;color:var(--color-primary);text-decoration:none;">Ofertas</a>
          <a href="/favorites" style="font-size:14px;font-weight:500;color:var(--color-text-secondary);text-decoration:none;transition:color 0.15s ease;">Favoritos</a>
          <a href="/notifications" style="font-size:14px;font-weight:500;color:var(--color-text-secondary);text-decoration:none;transition:color 0.15s ease;">Notificaciones</a>
        </nav>
        <div style="display:flex;align-items:center;gap:16px;">
          <button style="font-size:14px;font-weight:500;color:var(--color-text-secondary);background:none;border:none;cursor:pointer;padding:0;">Mi perfil</button>
        </div>
      </div>
    </header>

    <main class="wrap" id="main-content" style="padding-top:32px;padding-bottom:48px;">
      <h1 class="sr-only">Dashboard de ofertas</h1>

      <div id="sgva-sync" style="background:var(--color-primary);border-radius:10px;padding:20px;margin-bottom:24px;color:#fff;">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;">
          <div>
            <p style="font-weight:600;font-size:16px;margin-bottom:4px;">Sincronizar con SGVA</p>
            <p style="font-size:13px;opacity:0.85;">Ingresa tu numero de documento y contraseña del SGVA para obtener las ofertas mas recientes.</p>
          </div>
          <button id="btn-sgva-sync" style="height:36px;padding:0 20px;font-size:14px;font-weight:600;background:#fff;color:var(--color-primary);border:none;border-radius:8px;cursor:pointer;white-space:nowrap;">Sincronizar ahora</button>
        </div>
      </div>

      <div id="sgva-form" style="display:none;background:var(--color-bg-container);border:1px solid var(--color-border-secondary);border-radius:10px;padding:20px;margin-bottom:24px;">
        <p style="font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.14em;color:var(--color-primary);margin-bottom:16px;">Credenciales SGVA</p>
        <div style="display:flex;gap:12px;flex-wrap:wrap;">
          <input id="sgva-document" type="text" placeholder="Numero de documento" style="flex:1;min-width:180px;height:36px;padding:0 12px;font-size:14px;border:1px solid var(--color-border);border-radius:8px;background:var(--color-bg-container);color:var(--color-text);font-family:var(--font-sans);outline:none;">
          <input id="sgva-password" type="password" placeholder="Contraseña" style="flex:1;min-width:180px;height:36px;padding:0 12px;font-size:14px;border:1px solid var(--color-border);border-radius:8px;background:var(--color-bg-container);color:var(--color-text);font-family:var(--font-sans);outline:none;">
          <button id="btn-sgva-submit" style="height:36px;padding:0 20px;font-size:14px;font-weight:600;background:var(--color-primary);color:#fff;border:none;border-radius:8px;cursor:pointer;">Sincronizar</button>
          <button id="btn-sgva-cancel" style="height:36px;padding:0 20px;font-size:14px;font-weight:500;background:none;border:1px solid var(--color-border);border-radius:8px;cursor:pointer;color:var(--color-text-secondary);">Cancelar</button>
        </div>
        <p id="sgva-status" style="margin-top:12px;font-size:13px;display:none;"></p>
      </div>

      {!hasSynced ? (
        <div style="background:var(--color-bg-container);border:1px solid var(--color-border-secondary);border-radius:10px;padding:64px 24px;text-align:center;">
          <div style="font-size:48px;margin-bottom:16px;">📋</div>
          <h2 style="font-size:22px;font-weight:600;margin-bottom:8px;">Sincroniza tus datos del SGVA</h2>
          <p style="font-size:14px;color:var(--color-text-secondary);max-width:440px;margin:0 auto 24px;">Ingresa tu numero de documento y contraseña del portal SGVA para obtener las ofertas de aprendizaje mas recientes y sus evaluaciones.</p>
          <button id="btn-sgva-sync-main" style="height:40px;padding:0 24px;font-size:14px;font-weight:600;background:var(--color-primary);color:#fff;border:none;border-radius:8px;cursor:pointer;">Sincronizar con SGVA</button>
        </div>
      ) : (
        <>
        <div style="background:var(--color-bg-container);border:1px solid var(--color-border-secondary);border-radius:10px;padding:20px;margin-bottom:24px;">
        <p style="font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.14em;color:var(--color-primary);margin-bottom:16px;">Filtros</p>
        <div style="display:grid;grid-template-columns:repeat(3, 1fr);gap:16px;">
          <div>
            <label for="departamento" style="display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin-bottom:4px;font-size:12px;font-weight:600;color:var(--color-text);">Departamento</label>
            <select
              id="departamento"
              style="box-sizing:border-box;width:100%;font-family:var(--font-sans);font-size:14px;color:var(--color-text);background:var(--color-bg-container);border:1px solid var(--color-border);border-radius:8px;outline:none;height:32px;padding:0 12px;"
              onchange={`window.location='${buildFilterUrl({ departamento: '__VAL__', ciudad, modalidad })}'.replace('__VAL__', this.value)`}
            >
              <option value="">Todos</option>
              {departamentos.map((d) => (
                <option value={d} selected={departamento === d}>{d}</option>
              ))}
            </select>
          </div>
          <div>
            <label for="ciudad" style="display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin-bottom:4px;font-size:12px;font-weight:600;color:var(--color-text);">Ciudad</label>
            <select
              id="ciudad"
              style="box-sizing:border-box;width:100%;font-family:var(--font-sans);font-size:14px;color:var(--color-text);background:var(--color-bg-container);border:1px solid var(--color-border);border-radius:8px;outline:none;height:32px;padding:0 12px;"
              onchange={`window.location='${buildFilterUrl({ departamento, ciudad: '__VAL__', modalidad })}'.replace('__VAL__', this.value)`}
            >
              <option value="">Todas</option>
              {ciudades.map((c) => (
                <option value={c} selected={ciudad === c}>{c}</option>
              ))}
            </select>
          </div>
          <div>
            <label for="modalidad" style="display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin-bottom:4px;font-size:12px;font-weight:600;color:var(--color-text);">Modalidad</label>
            <select
              id="modalidad"
              style="box-sizing:border-box;width:100%;font-family:var(--font-sans);font-size:14px;color:var(--color-text);background:var(--color-bg-container);border:1px solid var(--color-border);border-radius:8px;outline:none;height:32px;padding:0 12px;"
              onchange={`window.location='${buildFilterUrl({ departamento, ciudad, modalidad: '__VAL__' })}'.replace('__VAL__', this.value)`}
            >
              <option value="">Todas</option>
              <option value="Remoto" selected={modalidad === 'Remoto'}>Remoto</option>
              <option value="Presencial" selected={modalidad === 'Presencial'}>Presencial</option>
              <option value="Hibrido" selected={modalidad === 'Hibrido'}>Hibrido</option>
            </select>
          </div>
        </div>
      </div>
      {offers.length === 0 ? (
        <div style="background:var(--color-bg-container);border:1px solid var(--color-border-secondary);border-radius:10px;padding:48px 24px;text-align:center;">
          <p style="font-size:16px;color:var(--color-text-secondary);">No se encontraron ofertas para los filtros seleccionados</p>
        </div>
      ) : (
        <div style="display:grid;grid-template-columns:repeat(2, 1fr);gap:16px;">
          {offers.map((offer) => {
            const scoreColor = getScoreColor(offer.score);
            const scoreLabel = getScoreLabel(offer.score);
            return (
              <div style="background:var(--color-bg-container);border:1px solid var(--color-border-secondary);border-radius:10px;padding:24px;box-shadow:0 1px 2px var(--color-fill-quaternary);">
                <div style="display:flex;align-items:flex-start;justify-content:space-between;">
                  <div style="flex:1;">
                    <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
                      <h3 style="font-size:22px;font-weight:600;color:var(--color-text);">{offer.titulo}</h3>
                      <span style={`display:inline-flex;align-items:center;height:24px;padding:0 8px;font-size:12px;font-weight:500;border-radius:5px;${offer.modalidad === 'Remoto' ? 'background:var(--color-success-bg);color:var(--color-success);' : offer.modalidad === 'Hibrido' ? 'background:var(--color-warning-bg);color:var(--color-warning);' : 'background:var(--color-primary-bg);color:var(--color-primary);'}`}>
                        {offer.modalidad}
                      </span>
                    </div>
                    <p style="font-size:14px;color:var(--color-text-secondary);margin-bottom:12px;">{offer.empresa}</p>
                    <div style="display:flex;align-items:center;gap:16px;font-size:12px;color:var(--color-text-tertiary);">
                      <span>{offer.ciudad}{offer.departamento ? `, ${offer.departamento}` : ''}</span>
                      {offer.fechaPublicacion && (
                        <span>Publicada hace {Math.floor((Date.now() - new Date(offer.fechaPublicacion).getTime()) / (1000 * 60 * 60 * 24))} dias</span>
                      )}
                    </div>
                  </div>
                  <div style="display:flex;flex-direction:column;align-items:flex-end;">
                    <div style="display:flex;align-items:baseline;gap:4px;">
                      <span style={`font-size:24px;font-weight:600;color:${scoreColor};`}>{Math.round(offer.score)}</span>
                      <span style="font-size:12px;color:var(--color-text-tertiary);">/100</span>
                    </div>
                    <span style={`font-size:12px;font-weight:500;color:${scoreColor};`}>{scoreLabel}</span>
                  </div>
                </div>
                <div style="display:flex;align-items:center;justify-content:space-between;margin-top:16px;padding-top:16px;border-top:1px solid var(--color-border-secondary);">
                  <a href={`/oferta/${offer.id}`} style="font-size:14px;font-weight:500;color:var(--color-text-secondary);text-decoration:none;transition:color 0.15s ease;">Ver detalles</a>
                  <button style="font-size:14px;font-weight:500;color:var(--color-text-secondary);background:none;border:none;cursor:pointer;padding:0;transition:color 0.15s ease;">Guardar</button>
                </div>
              </div>
            );
          })}
        </div>
      )}
      </>
      )}
    </main>
  </div>
</BaseLayout>

<script>
  const btnSync = document.getElementById('btn-sgva-sync');
  const btnSyncMain = document.getElementById('btn-sgva-sync-main');
  const formContainer = document.getElementById('sgva-form');
  const btnSubmit = document.getElementById('btn-sgva-submit');
  const btnCancel = document.getElementById('btn-sgva-cancel');
  const docInput = document.getElementById('sgva-document');
  const passInput = document.getElementById('sgva-password');
  const statusEl = document.getElementById('sgva-status');
  const syncSection = document.getElementById('sgva-sync');

  function showForm() {
    if (syncSection) syncSection.style.display = 'none';
    formContainer.style.display = 'block';
  }

  if (btnSync) btnSync.addEventListener('click', showForm);
  if (btnSyncMain) btnSyncMain.addEventListener('click', showForm);

  btnCancel.addEventListener('click', () => {
    formContainer.style.display = 'none';
    if (syncSection) syncSection.style.display = 'block';
  });

  btnSubmit.addEventListener('click', async () => {
    const doc = docInput.value.trim();
    const password = passInput.value;
    if (!doc || !password) {
      statusEl.textContent = 'Completa ambos campos.';
      statusEl.style.display = 'block';
      statusEl.style.color = 'var(--color-error)';
      return;
    }

    btnSubmit.disabled = true;
    btnSubmit.textContent = 'Sincronizando...';
    statusEl.style.display = 'none';

    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 180000);

    try {
      const res = await fetch('/api/sgva/sync', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ document: doc, password }),
        signal: controller.signal,
      });
      clearTimeout(timeout);

      const data = await res.json();

      if (!res.ok) {
        throw new Error(data.error || 'Error al sincronizar');
      }

      statusEl.textContent = `Sincronizacion exitosa: ${data.total} ofertas (${data.created} nuevas, ${data.updated} actualizadas). Recargando...`;
      statusEl.style.color = 'var(--color-success)';
      statusEl.style.display = 'block';

      setTimeout(() => window.location.reload(), 1500);
    } catch (err) {
      clearTimeout(timeout);
      statusEl.textContent = err.name === 'AbortError' ? 'Error: la sincronizacion tardó demasiado. Intenta de nuevo.' : 'Error: ' + err.message;
      statusEl.style.color = 'var(--color-error)';
      statusEl.style.display = 'block';
      btnSubmit.disabled = false;
      btnSubmit.textContent = 'Sincronizar';
    }
  });
</script>

<style>
  @media (max-width: 768px) {
    main.wrap {
      padding-left: 16px;
      padding-right: 16px;
    }
    div[style*="grid-template-columns:repeat(3, 1fr)"] {
      grid-template-columns: 1fr !important;
    }
    div[style*="grid-template-columns:repeat(2, 1fr)"] {
      grid-template-columns: 1fr !important;
    }
  }
</style>
