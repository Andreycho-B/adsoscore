---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Dashboard">
  <div style="min-height:100vh;background:var(--color-bg-layout);">
    <header style="background:var(--color-bg-container);border-bottom:1px solid var(--color-border);position:sticky;top:0;z-index:40;">
      <div class="wrap" style="display:flex;justify-content:space-between;align-items:center;height:64px;">
        <div style="display:flex;align-items:center;gap:12px;">
          <a href="/" style="font-weight:600;font-size:18px;letter-spacing:-0.01em;color:var(--color-primary);text-decoration:none;">ADSOscore</a>
        </div>
        <nav aria-label="Navegacion principal" style="display:flex;gap:28px;align-items:center;">
          <a href="/dashboard" style="font-size:14px;font-weight:600;color:var(--color-primary);text-decoration:none;">Ofertas</a>
          <a href="/favorites" style="font-size:14px;font-weight:500;color:var(--color-text-secondary);text-decoration:none;transition:color 0.15s ease;">Favoritos</a>
          <a href="/notifications" style="font-size:14px;font-weight:500;color:var(--color-text-secondary);text-decoration:none;transition:color 0.15s ease;">Notificaciones</a>
        </nav>
        <div style="display:flex;align-items:center;gap:16px;">
          <button style="font-size:14px;font-weight:500;color:var(--color-text-secondary);background:none;border:none;cursor:pointer;padding:0;">Mi perfil</button>
        </div>
      </div>
    </header>

    <main class="wrap" id="main-content" style="padding-top:32px;padding-bottom:48px;">
      <h1 class="sr-only">Dashboard de ofertas</h1>
      <div style="background:var(--color-bg-container);border:1px solid var(--color-border-secondary);border-radius:10px;padding:20px;margin-bottom:24px;">
        <p style="font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.14em;color:var(--color-primary);margin-bottom:16px;">Filtros</p>
        <div style="display:grid;grid-template-columns:repeat(4, 1fr);gap:16px;">
          <div>
            <label for="departamento" style="display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin-bottom:4px;font-size:12px;font-weight:600;color:var(--color-text);">Departamento</label>
            <select id="departamento" style="box-sizing:border-box;width:100%;font-family:var(--font-sans);font-size:14px;color:var(--color-text);background:var(--color-bg-container);border:1px solid var(--color-border);border-radius:8px;outline:none;height:32px;padding:0 12px;">
              <option value="">Todos</option>
              <option value="Caldas">Caldas</option>
              <option value="Risaralda">Risaralda</option>
              <option value="Antioquia">Antioquia</option>
              <option value="Cundinamarca">Cundinamarca</option>
              <option value="Santander">Santander</option>
            </select>
          </div>
          <div>
            <label for="ciudad" style="display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin-bottom:4px;font-size:12px;font-weight:600;color:var(--color-text);">Ciudad</label>
            <select id="ciudad" style="box-sizing:border-box;width:100%;font-family:var(--font-sans);font-size:14px;color:var(--color-text);background:var(--color-bg-container);border:1px solid var(--color-border);border-radius:8px;outline:none;height:32px;padding:0 12px;">
              <option value="">Todas</option>
              <option value="Manizales">Manizales</option>
              <option value="Pereira">Pereira</option>
              <option value="Medellin">Medellin</option>
              <option value="Bogota">Bogota</option>
              <option value="Bucaramanga">Bucaramanga</option>
            </select>
          </div>
          <div>
            <label for="modalidad" style="display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin-bottom:4px;font-size:12px;font-weight:600;color:var(--color-text);">Modalidad</label>
            <select id="modalidad" style="box-sizing:border-box;width:100%;font-family:var(--font-sans);font-size:14px;color:var(--color-text);background:var(--color-bg-container);border:1px solid var(--color-border);border-radius:8px;outline:none;height:32px;padding:0 12px;">
              <option value="">Todas</option>
              <option value="Remoto">Remoto</option>
              <option value="Presencial">Presencial</option>
              <option value="Hibrido">Hibrido</option>
            </select>
          </div>
          <div>
            <label for="tipo-empresa" style="display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin-bottom:4px;font-size:12px;font-weight:600;color:var(--color-text);">Tipo de empresa</label>
            <select id="tipo-empresa" style="box-sizing:border-box;width:100%;font-family:var(--font-sans);font-size:14px;color:var(--color-text);background:var(--color-bg-container);border:1px solid var(--color-border);border-radius:8px;outline:none;height:32px;padding:0 12px;">
              <option value="">Todas</option>
              <option value="startup">Startup</option>
              <option value="consultora">Consultora</option>
              <option value="enterprise">Enterprise</option>
              <option value="fintech">Fintech</option>
            </select>
          </div>
        </div>
      </div>

      <div style="display:flex;flex-direction:column;gap:16px;">
        <div style="background:var(--color-bg-container);border:1px solid var(--color-border-secondary);border-radius:10px;padding:24px;box-shadow:0 1px 2px var(--color-fill-quaternary);">
          <div style="display:flex;align-items:flex-start;justify-content:space-between;">
            <div style="flex:1;">
              <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
                <h3 style="font-size:22px;font-weight:600;color:var(--color-text);">Desarrollador Full Stack</h3>
                <span style="display:inline-flex;align-items:center;height:24px;padding:0 8px;font-size:12px;font-weight:500;background:var(--color-success-bg);color:var(--color-success);border-radius:5px;">Remoto</span>
              </div>
              <p style="font-size:14px;color:var(--color-text-secondary);margin-bottom:12px;">Tech Solutions S.A.S</p>
              <div style="display:flex;align-items:center;gap:16px;font-size:12px;color:var(--color-text-tertiary);">
                <span>Bogota, Cundinamarca</span>
                <span>Publicada hace 2 dias</span>
              </div>
            </div>
            <div style="display:flex;flex-direction:column;align-items:flex-end;">
              <div style="display:flex;align-items:baseline;gap:4px;">
                <span style="font-size:24px;font-weight:600;color:var(--color-success);">85</span>
                <span style="font-size:12px;color:var(--color-text-tertiary);">/100</span>
              </div>
              <span style="font-size:12px;font-weight:500;color:var(--color-success);">Excelente</span>
            </div>
          </div>
          <div style="display:flex;align-items:center;justify-content:space-between;margin-top:16px;padding-top:16px;border-top:1px solid var(--color-border-secondary);">
            <button style="font-size:14px;font-weight:500;color:var(--color-text-secondary);background:none;border:none;cursor:pointer;padding:0;transition:color 0.15s ease;">Ver detalles</button>
            <button style="font-size:14px;font-weight:500;color:var(--color-text-secondary);background:none;border:none;cursor:pointer;padding:0;transition:color 0.15s ease;">Guardar</button>
          </div>
        </div>

        <div style="background:var(--color-bg-container);border:1px solid var(--color-border-secondary);border-radius:10px;padding:24px;box-shadow:0 1px 2px var(--color-fill-quaternary);">
          <div style="display:flex;align-items:flex-start;justify-content:space-between;">
            <div style="flex:1;">
              <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
                <h3 style="font-size:22px;font-weight:600;color:var(--color-text);">Practicante de Desarrollo</h3>
                <span style="display:inline-flex;align-items:center;height:24px;padding:0 8px;font-size:12px;font-weight:500;background:var(--color-warning-bg);color:var(--color-warning);border-radius:5px;">Presencial</span>
              </div>
              <p style="font-size:14px;color:var(--color-text-secondary);margin-bottom:12px;">Consultora XYZ Ltda</p>
              <div style="display:flex;align-items:center;gap:16px;font-size:12px;color:var(--color-text-tertiary);">
                <span>Manizales, Caldas</span>
                <span>Publicada hace 5 dias</span>
              </div>
            </div>
            <div style="display:flex;flex-direction:column;align-items:flex-end;">
              <div style="display:flex;align-items:baseline;gap:4px;">
                <span style="font-size:24px;font-weight:600;color:var(--color-warning);">62</span>
                <span style="font-size:12px;color:var(--color-text-tertiary);">/100</span>
              </div>
              <span style="font-size:12px;font-weight:500;color:var(--color-warning);">Buena</span>
            </div>
          </div>
          <div style="display:flex;align-items:center;justify-content:space-between;margin-top:16px;padding-top:16px;border-top:1px solid var(--color-border-secondary);">
            <button style="font-size:14px;font-weight:500;color:var(--color-text-secondary);background:none;border:none;cursor:pointer;padding:0;transition:color 0.15s ease;">Ver detalles</button>
            <button style="font-size:14px;font-weight:500;color:var(--color-text-secondary);background:none;border:none;cursor:pointer;padding:0;transition:color 0.15s ease;">Guardar</button>
          </div>
        </div>
      </div>
    </main>
  </div>
</BaseLayout>
