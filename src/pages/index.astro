---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="ADSOscore - Encuentra las mejores empresas para tu aprendizaje">
  <div class="min-h-screen bg-white">
    <!-- Header -->
    <header class="bg-white border-b border-[#E5E7EB]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          <div class="flex items-center gap-2">
            <span class="text-xl font-bold text-[#1E3A5F]">ADSOscore</span>
          </div>
          <nav class="flex items-center gap-6">
            <a href="#features" class="text-sm font-medium text-[#6B7280] hover:text-[#111827]">
              Caracteristicas
            </a>
            <a href="/login" class="inline-flex items-center justify-center px-4 py-2 text-sm font-medium text-white bg-[#1E3A5F] rounded-md hover:bg-[#2D5A8F] transition-colors">
              Iniciar sesion
            </a>
          </nav>
        </div>
      </div>
    </header>

    <!-- Hero -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="text-center max-w-3xl mx-auto">
        <h1 class="text-4xl sm:text-5xl font-bold text-[#111827] mb-6 leading-tight">
          Encuentra las mejores empresas para tu aprendizaje
        </h1>
        <p class="text-lg text-[#6B7280] mb-8">
          Evalua empresas del SGVA con scores inteligentes basados en GitHub, RUES, ubicacion y mas.
          Toma decisiones informadas sobre tu futuro profesional.
        </p>
        <div class="flex justify-center gap-4">
          <a
            href="/login"
            class="inline-flex items-center justify-center px-6 py-3 text-base font-medium text-white bg-[#1E3A5F] rounded-lg hover:bg-[#2D5A8F] transition-colors"
          >
            Comenzar ahora
          </a>
          <a
            href="/dashboard"
            class="inline-flex items-center justify-center px-6 py-3 text-base font-medium text-[#111827] bg-white border border-[#E5E7EB] rounded-lg hover:bg-[#F9FAFB] transition-colors"
          >
            Ver ofertas
          </a>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section id="features" class="bg-[#F9FAFB] py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-[#111827] mb-4">Por que usar ADSOscore</h2>
          <p class="text-[#6B7280] max-w-2xl mx-auto">
            Herramientas disenas para ayudarte a encontrar la mejor empresa de aprendizaje
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Feature 1 -->
          <div class="bg-white rounded-lg border border-[#E5E7EB] p-6">
            <div class="w-10 h-10 bg-[#1E3A5F]/10 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-[#1E3A5F]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-[#111827] mb-2">Scores inteligentes</h3>
            <p class="text-[#6B7280]">
              Cada empresa tiene un score basado en 10 parametros: GitHub, RUES, Glassdoor, ubicacion y mas.
            </p>
          </div>

          <!-- Feature 2 -->
          <div class="bg-white rounded-lg border border-[#E5E7EB] p-6">
            <div class="w-10 h-10 bg-[#059669]/10 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-[#059669]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-[#111827] mb-2">Resenas verificadas</h3>
            <p class="text-[#6B7280]">
              Lee resenas de otros aprendices que ya pasaron por la empresa. Sistema anti-fraude incluido.
            </p>
          </div>

          <!-- Feature 3 -->
          <div class="bg-white rounded-lg border border-[#E5E7EB] p-6">
            <div class="w-10 h-10 bg-[#2563EB]/10 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-[#2563EB]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-[#111827] mb-2">Filtros avanzados</h3>
            <p class="text-[#6B7280]">
              Filtra por departamento, ciudad, modalidad, tags y mas. Encuentra exactamente lo que buscas.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-bold text-[#111827] mb-4">Comienza hoy</h2>
        <p class="text-[#6B7280] mb-8 max-w-xl mx-auto">
          Unete a otros aprendices del SENA que ya estan tomando decisiones informadas sobre su futuro profesional.
        </p>
        <a
          href="/login"
          class="inline-flex items-center justify-center px-8 py-3 text-base font-medium text-white bg-[#1E3A5F] rounded-lg hover:bg-[#2D5A8F] transition-colors"
        >
          Crear cuenta gratis
        </a>
      </div>
    </section>

    <!-- Footer -->
    <footer class="bg-[#111827] text-white py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row justify-between items-center">
          <div class="mb-4 md:mb-0">
            <span class="text-xl font-bold">ADSOscore</span>
            <p class="text-sm text-[#9CA3AF] mt-1">Plataforma de evaluacion de empresas para aprendices ADS</p>
          </div>
          <div class="flex gap-6 text-sm text-[#9CA3AF]">
            <span>Hecho para aprendices del SENA</span>
          </div>
        </div>
        <div class="border-t border-[#374151] mt-8 pt-8 text-center text-sm text-[#6B7280]">
          ADSOscore - Sistema de Graduacion de Vacantes de Aprendizaje
        </div>
      </div>
    </footer>
  </div>
</BaseLayout>
