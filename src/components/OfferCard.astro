---
import { getScoreLabel, getScoreColor } from '../lib/scoring';

interface Props {
  offer: {
    id: string;
    titulo: string;
    empresa: string;
    ciudad?: string | null;
    departamento?: string | null;
    modalidad?: string | null;
    score?: number | null;
    isRelevantForAds?: boolean;
    fechaPublicacion?: Date | string | null;
  };
}

const { offer } = Astro.props;
const scoreVal = offer.score ?? 0;
const scoreColor = getScoreColor(scoreVal);
const scoreLabel = getScoreLabel(scoreVal);
---

<div style="background:var(--color-bg-container);border:1px solid var(--color-border-secondary);border-radius:10px;padding:20px;box-shadow:0 1px 2px var(--color-fill-quaternary);display:flex;flex-direction:column;gap:12px;">
  <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;">
    <div style="flex:1;min-width:0;">
      <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-bottom:4px;">
        <h3 style="font-size:15px;font-weight:600;color:var(--color-text);margin:0;line-height:1.3;">{offer.titulo}</h3>
        {offer.isRelevantForAds === false && (
          <span style="display:inline-flex;align-items:center;height:18px;padding:0 5px;font-size:9px;font-weight:600;border-radius:3px;background:var(--color-bg-layout);color:var(--color-text-tertiary);border:1px solid var(--color-border);">No ADS</span>
        )}
        {offer.isRelevantForAds === true && (
          <span style="display:inline-flex;align-items:center;height:18px;padding:0 5px;font-size:9px;font-weight:600;border-radius:3px;background:var(--color-success-bg);color:var(--color-success);">ADS</span>
        )}
      </div>
      <p style="font-size:13px;color:var(--color-text-secondary);margin:0;">{offer.empresa}</p>
    </div>
    <div style="display:flex;flex-direction:column;align-items:flex-end;flex-shrink:0;">
      <span style="font-size:20px;font-weight:600;color:var(--color-text);line-height:1;">{Math.round(scoreVal)}</span>
      <span style={`font-size:10px;font-weight:500;color:${scoreColor};`}>{scoreLabel}</span>
    </div>
  </div>
  <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;font-size:12px;color:var(--color-text-tertiary);">
    {offer.ciudad && <span>{offer.ciudad}{offer.departamento ? `, ${offer.departamento}` : ''}</span>}
    {offer.modalidad && (
      <span style={`display:inline-flex;align-items:center;height:20px;padding:0 6px;font-size:10px;font-weight:500;border-radius:4px;${offer.modalidad === 'Remoto' ? 'background:var(--color-success-bg);color:var(--color-success);' : offer.modalidad === 'Hibrido' ? 'background:var(--color-warning-bg);color:var(--color-warning);' : 'background:var(--color-primary-bg);color:var(--color-primary);'}`}>
        {offer.modalidad}
      </span>
    )}
    {offer.fechaPublicacion && (
      <span>{Math.floor((Date.now() - new Date(offer.fechaPublicacion).getTime()) / (1000 * 60 * 60 * 24))} d</span>
    )}
  </div>
  <div style="display:flex;align-items:center;gap:12px;padding-top:8px;border-top:1px solid var(--color-border-secondary);">
    <a href={`/oferta/${offer.id}`} style="font-size:12px;font-weight:500;color:var(--color-text-secondary);text-decoration:none;">Ver detalles</a>
    <button style="font-size:12px;font-weight:500;color:var(--color-text-tertiary);background:none;border:none;cursor:pointer;padding:0;">Guardar</button>
  </div>
</div>